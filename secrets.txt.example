# ============================================================
# MusicWeb 隐私配置模板
# 使用方法：复制本文件，重命名为 secrets.txt，填写你自己的配置值
# ============================================================

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=musicweb
DB_USER=
DB_PASSWORD=

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379

# Docker/服务编排配置
MUSIC_API_URL=http://localhost:3000
QQ_API_URL=http://127.0.0.1:8000
UNBLOCK_API_URL=http://127.0.0.1:8081

# 邮件配置（163 邮件，申诉通知用）
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Last.fm API（歌曲元数据补全用，可选）
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=

# 源码webapp路径（开发环境封面图片代理用，可选）
SOURCE_WEBAPP_PATH=
