# ============================================================
# MusicWeb 隐私配置模板
# 使用方法：复制本文件，重命名为 secrets.txt，填写你自己的配置值
# ============================================================

# 数据库配置
DB_USER=
DB_PASSWORD=

# 邮件配置（163 邮件，申诉通知用）
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Last.fm API（歌曲元数据补全用，可选）
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
