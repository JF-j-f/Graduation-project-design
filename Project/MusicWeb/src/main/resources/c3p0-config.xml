<?xml version="1.0" encoding="UTF-8"?>
<c3p0-config>
    <named-config name="musicweb">
        <!-- MySQL 8.4.0 驱动 -->
        <property name="driverClass">com.mysql.cj.jdbc.Driver</property>
        <!-- 数据库连接信息（user/password 由 SecretsLoader 注入 System.properties，DBUtil 编程式设置） -->
        <property name="jdbcUrl">jdbc:mysql://localhost:3306/musicweb?useUnicode=true&amp;characterEncoding=UTF-8&amp;serverTimezone=Asia/Shanghai&amp;useSSL=false&amp;allowPublicKeyRetrieval=true</property>

        <!-- 连接池参数 -->
        <property name="initialPoolSize">5</property>
        <property name="minPoolSize">5</property>
        <property name="maxPoolSize">20</property>
        <property name="maxIdleTime">300</property>
        <property name="checkoutTimeout">30000</property>
        <property name="idleConnectionTestPeriod">30</property>
        <property name="testConnectionOnCheckout">true</property>
        <property name="preferredTestQuery">SELECT 1</property>
        <property name="acquireRetryAttempts">3</property>
        <property name="acquireRetryDelay">1000</property>
    </named-config>
</c3p0-config>