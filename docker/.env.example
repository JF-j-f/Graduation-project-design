# ============================================================
# MusicWeb Docker 运行配置模板
# 使用方法：复制到 docker/private/.env 后填写或保留默认值
# ============================================================

DB_NAME=musicweb
DB_HOST=mysql
DB_PORT=3306
DB_USER=musicweb
DB_PASSWORD=musicweb_password
MYSQL_ROOT_PASSWORD=musicweb_root_password

REDIS_HOST=redis
REDIS_PORT=6379

MUSIC_API_URL=http://music-api:3000
QQ_API_URL=http://qq-api:8000
UNBLOCK_API_URL=http://unblock:8081

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

LASTFM_API_KEY=
LASTFM_SHARED_SECRET=

SOURCE_WEBAPP_PATH=

MYSQL_PUBLIC_PORT=3307
REDIS_PUBLIC_PORT=6379
MUSIC_API_PUBLIC_PORT=3000
QQ_API_PUBLIC_PORT=8000
UNBLOCK_PUBLIC_PORT=8081
MUSICWEB_PUBLIC_PORT=8082
